    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"id\": \"initial_id\",\n",
    "   \"metadata\": {\n",
    "    \"collapsed\": true,\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-01-10T16:37:16.748186613Z\",\n",
    "     \"start_time\": \"2026-01-10T16:37:16.592251020Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from matplotlib.collections import LineCollection\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 1. Setup Data\\n\",\n",
    "    \"x = np.linspace(0, 10, 100)\\n\",\n",
    "    \"# y is (100, 3) -> 100 points per line, 3 different lines\\n\",\n",
    "    \"y = np.array([np.sin(x), np.cos(x), np.sin(x / 2)]).T\\n\",\n",
    "    \"# color_values is (100, 3) -> determines color at each segment\\n\",\n",
    "    \"color_values = np.linspace(0, 1, 100).reshape(-1, 1) * np.ones((1, 3))\\n\",\n",
    "    \"color_values = np.random.rand(100, 3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"fig, ax = plt.subplots(figsize=(10, 6))\\n\",\n",
    "    \"cmap = plt.get_cmap('brg')\\n\",\n",
    "    \"norm = plt.Normalize(vmin=0, vmax=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 2. Loop through each column (graph)\\n\",\n",
    "    \"for i in range(y.shape[1]):\\n\",\n",
    "    \"    # Create segments: (x0, y0) to (x1, y1)\\n\",\n",
    "    \"    points = np.array([x, y[:, i]]).T.reshape(-1, 1, 2)\\n\",\n",
    "    \"    segments = np.concatenate([points[:-1], points[1:]], axis=1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Create LineCollection\\n\",\n",
    "    \"    lc = LineCollection(segments, cmap=cmap, norm=norm, linewidth=2.5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Set the array to use for the color mapping\\n\",\n",
    "    \"    lc.set_array(color_values[:, i])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Add to plot\\n\",\n",
    "    \"    line = ax.add_collection(lc)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 3. Finalize Plot\\n\",\n",
    "    \"ax.set_xlim(x.min(), x.max())\\n\",\n",
    "    \"ax.set_ylim(y.min() - 0.1, y.max() + 0.1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add colorbar using the last LineCollection object\\n\",\n",
    "    \"cbar = fig.colorbar(plt.cm.ScalarMappable(norm=norm, cmap=cmap), ax=ax)\\n\",\n",
    "    \"cbar.set_label('Value from 3rd Array')\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_title('Multi-graph Gradient Lines using LineCollection')\\n\",\n",
    "    \"plt.grid(True, alpha=0.3)\\n\",\n",
    "    \"plt.show()\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"data\": {\n",
